# CLI assembly work + outputs (regenerated every build)
apps/sera-login/android/apk-work/
apps/sera-login/android/*.apk
apps/sera-login/android/*.idsig
apps/sera-login/android/*.keystore
# CLI web bundles (regenerated by serve/build --web)
apps/sera-login/web/pkg/
# Same generated bundle for the motion lab (same convention)
apps/motion/web/pkg/
# Demo-shell web bundles (regenerated by every web build/test)
crates/oppa-web/web/pkg/
