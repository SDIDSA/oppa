// Version resource for an Oppa desktop app (Round 25.5, decision 340).
//
// Build (MSVC `rc`, manual — no automation claims it):
//   rc hello.rc            // produces hello.res
//   // then link hello.res into your exe (rustc -C link-args, or a build.rs
//   // emitting `cargo:rustc-link-arg=hello.res`).
//
// Icons: add `IDI_ICON1 ICON "app.ico"` once you have your own .ico —
// none ships here (converting your artwork to .ico is app branding,
// not framework code). Version below tracks the workspace Cargo
// version (0.1.0); bump FILEVERSION/PRODUCTVERSION with releases.

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Example"
            VALUE "FileDescription",  "Hello, Oppa (Oppa desktop app)"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "hello"
            VALUE "OriginalFilename", "hello.exe"
            VALUE "ProductName",      "Hello, Oppa"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
