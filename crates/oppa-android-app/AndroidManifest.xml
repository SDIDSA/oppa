<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.oppa.app"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- No hardcoded android:debuggable here (lint HardcodedDebugMode
        is fatal on release): Gradle debug builds auto-assign
        debuggable=true. The manual aapt2 fallback path must pass the
        link-time debug-mode flag to keep run-as working. -->
    <application android:label="oppa"
        android:hasCode="true"
        android:extractNativeLibs="true">
        <activity android:name="android.app.NativeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <meta-data android:name="android.app.lib_name" android:value="oppa_android_app" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- SAF open trampoline (decision 427): transparent receiver
            for the chooser result — NativeActivity cannot take
            `onActivityResult`, so this activity fires the intent and
            forwards bytes to native, then finishes. Unexported, off
            recents. NOTE: no `noHistory` here — the trampoline must
            survive in the stack behind DocumentsUI, otherwise the
            result has nowhere to land and the pick vanishes. -->
        <activity android:name="com.oppa.app.OppaPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
